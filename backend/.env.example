# Copy to .env (gitignored) for local development. On the server, set these as environment variables
# on cPanel's Setup Node.js App page instead (see ../DEPLOY.md, "The Node app").

# Required: the Bearer token Folio sends for writes. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=

# Optional (defaults shown or described)
# PORT=3001
# FRONTEND_URL=https://jordan-christensen.com   # added to the CORS allowlist
# SITE_URL=https://jordan-christensen.com       # absolute URLs in sitemap.xml, feed.xml, share pages
# DATA_DIR=                                     # default: <backend root>/data (~/data on the server)
# PUBLIC_DIR=                                   # default: <backend root>/public_html (~/public_html on the server)
# MEDIA_DIR=                                    # default: $PUBLIC_DIR/media
