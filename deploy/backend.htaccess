# Template for the backend's environment variables, as SetEnv lines in the .htaccess cPanel uses for
# the Node app (usually the same ~/public_html/.htaccess, outside the "DO NOT EDIT" Passenger block,
# or the one in the app's URL folder). Fill in real values on the server only; never commit them.

SetEnv API_SECRET "replace-with-at-least-32-random-characters"
SetEnv FRONTEND_URL "https://jordan-christensen.com"
SetEnv SITE_URL "https://jordan-christensen.com"

# Only if the defaults (relative to ~/backend-server) are wrong for this account:
# SetEnv DATA_DIR "/home/<user>/data"
# SetEnv PUBLIC_DIR "/home/<user>/public_html"
# SetEnv MEDIA_DIR "/home/<user>/public_html/media"
