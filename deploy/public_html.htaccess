# A copy of the live ~/public_html/.htaccess (deployed October 29, 2026). Keep them in step: edit this
# copy, then paste it into cPanel's File Manager. The AutoSSL block above is managed by cPanel; leave it
# as it is. See DEPLOY.md ("The .htaccess").

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Legacy app URL redirects
    RewriteRule ^([^/]+)-privacy$ /apps/$1/privacy-policy [R=302,L]
    RewriteRule ^([^/]+)-support$ /apps/$1/support [R=302,L]

    # Short-form app page redirects
    RewriteRule ^([^/]+)/privacy-policy/?$ /apps/$1/privacy-policy [R=301,L]
    RewriteRule ^([^/]+)/support/?$ /apps/$1/support [R=301,L]

    # Share pages: the backend writes _meta/<path>.html (index.html with this page's title and
    # Open Graph tags) so link previews work. Serve it when it exists; the URL doesn't change.
    RewriteCond %{DOCUMENT_ROOT}/_meta/$1.html -f
    RewriteRule ^((?:projects|blog)(?:/[a-z0-9-]+)?|apps/[a-z0-9-]+/(?:privacy-policy|support))/?$ /_meta/$1.html [L]

    # Let real files and directories through (JS, CSS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Don't rewrite API or media requests — let those reach the backend
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/media/

    # Everything else → index.html, React Router takes over
    RewriteRule . /index.html [L]
</IfModule>

# HTML must revalidate so a deploy shows up right away; hashed files in /assets never change.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
